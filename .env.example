# Model (accept the Gemma license on Hugging Face before first use)
HF_TOKEN=
MODEL_ID=google/gemma-3-1b-it
MODEL_DEVICE=cpu
MODEL_DTYPE=float32
MODEL_QUANTIZATION=none
MAX_NEW_TOKENS=1024
MODEL_CONTEXT_MESSAGES=12
CPU_THREADS=0
DOCUMENT_MAX_CHARS=24000
TEMPERATURE=0.2

# Server and storage
APP_HOST=127.0.0.1
APP_PORT=8765
APP_DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173

# Optional web research
TAVILY_API_KEY=

# Optional Phoenix (run `phoenix serve` locally)
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces

# Optional local image model (large download). Leave blank for disabled.
IMAGE_MODEL_ID=
